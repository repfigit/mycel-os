# Void Linux x86_64-musl ISO Builder
# Used to build static musl mycel-runtime and bootable Mycel OS ISOs

FROM ghcr.io/void-linux/void-musl-full:latest

# Install void-mklive and Rust/Wayland build dependencies in ONE xbps
# transaction: a second `xbps-install` errors "already installed" for packages
# that `-Syu` pulled in as dependencies (tar, gzip, liblz4). `seatd-devel` does
# not exist in the Void musl pool — `libseat-devel` ships the headers and `.pc`.
RUN xbps-install -Syu -y \
    bash \
    git \
    xorriso \
    squashfs-tools \
    dosfstools \
    e2fsprogs \
    mtools \
    grub-x86_64-efi \
    grub \
    xz \
    curl \
    cpio \
    file \
    gcc \
    cmake \
    make \
    llvm-libunwind-devel \
    rust \
    cargo \
    pkg-config \
    libxkbcommon-devel \
    libseat-devel \
    libinput-devel \
    eudev-libudev-devel \
    libdrm-devel \
    MesaLib-devel \
    pixman-devel \
    wayland-devel

WORKDIR /build

# Pre-clone void-mklive
RUN git clone --depth 1 https://github.com/void-linux/void-mklive.git /opt/void-mklive

# Copy build script
COPY void-build-iso.sh /build/void-build-iso.sh
RUN chmod +x /build/void-build-iso.sh

CMD ["/build/void-build-iso.sh"]
